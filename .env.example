# ReportPilot environment. Copy to .env and fill in what you need.
# Nothing here is required for the demo: `npm run dev` and `npm run demo`
# work with the bundled sample agency and no keys at all.

# Postgres (Neon or Supabase free tier). Use the pooled connection string.
# Setting it switches the dashboard from the demo to email sign-in.
DATABASE_URL=
DATABASE_POOL_MAX=5

# Signs session cookies and print URLs. 32+ random characters: openssl rand -hex 32
AUTH_SECRET=
AUTH_EMAIL_FROM=ReportPilot <sign-in@example.com>

# "test" captures report emails on the Sent emails page instead of sending.
EMAIL_MODE=

# Resend webhook signing secret (whsec_...) for delivery and bounce events.
RESEND_WEBHOOK_SECRET=

# Google Cloud service account JSON, on one line. Each client adds its
# client_email to their Search Console property as a Restricted user.
GOOGLE_SERVICE_ACCOUNT_JSON=

# PageSpeed Insights and CrUX History (same Google API key, free).
PAGESPEED_API_KEY=

# Optional AI wording. Only aggregated figures are sent; any number the
# model changes is rejected by the number check and the template is used.
GEMINI_API_KEY=

# Email delivery (Resend free tier: 3,000 a month, 100 a day).
RESEND_API_KEY=

# PDF storage on Cloudflare R2 (10 GB free, no egress fees).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Heartbeats (Healthchecks.io, free for 20 checks).
HEALTHCHECK_MONTHLY_URL=
HEALTHCHECK_DAILY_URL=

# Alert emails from the daily job and the uptime worker.
ALERT_FROM=ReportPilot alerts <alerts@example.com>
ALERT_TO=

# Optional: lets onboarding start the backfill on GitHub Actions immediately.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=

# Public URL of the dashboard, used in client report links.
APP_URL=http://localhost:3000

# Error tracking (Sentry free developer plan).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
